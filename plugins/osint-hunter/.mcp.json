{
  "mcpServers": {
    "virustotal": {
      "command": "npx",
      "args": ["-y", "@burtthecoder/mcp-virustotal"],
      "env": {
        "VIRUSTOTAL_API_KEY": "${user_config.virustotal_key}"
      }
    },
    "threat-intel": {
      "command": "uv",
      "args": ["run", "--directory", "./mcp-servers/threat-intel", "server.py"],
      "env": {
        "ABUSEIPDB_API_KEY": "${user_config.abuseipdb_key}",
        "OTX_API_KEY": "${user_config.otx_key}",
        "FOFA_KEY": "${user_config.fofa_key}"
      }
    }
  }
}
